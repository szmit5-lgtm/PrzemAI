generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  role     String @default("user")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories     History[]
  tasks         Task[]
  conversations ChatConversation[]
  memories      Memory[]
  settings      UserSettings?

  agents        Agent[]
  integrations  Integration[]
  projects      Project[]
  financialDocuments FinancialDocument[]
  organizationMemberships OrganizationMembership[]
  linkedOrganizationFinances OrganizationFinanceLink[]
}

model History {
  id       String @id @default(cuid())
  title    String
  filename String
  type     String
  report   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  status   String @default("TODO")
  priority String @default("MEDIUM")

  source String  @default("MANUAL")
  owner  String?

  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  tags     String[]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([dueDate])
}

model ChatConversation {
  id    String @id @default(cuid())
  title String @default("Nowa rozmowa")

  archivedAt    DateTime?
  lastMessageAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@index([userId])
  @@index([userId, lastMessageAt])
  @@index([archivedAt])
}

model ChatMessage {
  id      String @id @default(cuid())
  role    String
  content String

  metadata Json?

  createdAt DateTime @default(now())

  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Memory {
  id String @id @default(cuid())

  type    String
  title   String
  content String

  source String @default("MANUAL")

  importance Int @default(3)

  tags     String[]
  metadata Json?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([source])
  @@index([importance])
  @@index([archivedAt])
  @@index([createdAt])
}

model UserSettings {
  id String @id @default(cuid())

  memoryEnabled  Boolean @default(true)
  historyEnabled Boolean @default(true)
  executiveMode  Boolean @default(true)
  aiModel        String  @default("gpt-5.5")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Agent {
  id String @id @default(cuid())

  key  String
  name String
  type String

  enabled Boolean @default(true)
  status  String  @default("IDLE")

  intervalMinutes Int @default(15)

  lastRunAt DateTime?
  nextRunAt DateTime?

  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  runs AgentRun[]

  @@unique([userId, key])
  @@index([userId])
  @@index([type])
  @@index([enabled])
  @@index([nextRunAt])
}

model AgentRun {
  id String @id @default(cuid())

  status  String
  trigger String

  startedAt  DateTime @default(now())
  finishedAt DateTime?

  summary  String?
  error    String?
  metadata Json?

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@index([startedAt])
}

model Integration {
  id String @id @default(cuid())

  type     String
  provider String
  name     String

  enabled Boolean @default(false)

  config Json

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([provider])
  @@index([enabled])
}

model Project {
  id String @id @default(cuid())

  name   String
  code   String?
  status String @default("ACTIVE")

  company String?
  aliases String[]

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  financialDocuments FinancialDocument[]

  @@index([userId])
  @@index([status])
  @@index([name])
}

model FinancialDocument {
  id String @id @default(cuid())

  source     String
  externalId String?

  direction String?
  status    String @default("NEW")

  invoiceNumber String?
  ksefNumber    String?

  sellerName String?
  sellerNip  String?
  buyerName  String?
  buyerNip   String?

  issueDate DateTime?
  saleDate  DateTime?
  dueDate   DateTime?

  currency String @default("PLN")

  netAmount   Decimal? @db.Decimal(18, 2)
  vatAmount   Decimal? @db.Decimal(18, 2)
  grossAmount Decimal? @db.Decimal(18, 2)

  rawData Json?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, source, externalId])
  @@index([userId])
  @@index([source])
  @@index([status])
  @@index([direction])
  @@index([sellerNip])
  @@index([buyerNip])
  @@index([issueDate])
  @@index([dueDate])
  @@index([projectId])
}


/// Organization foundation for future White Label / multi-tenant rollout.
/// These models are additive; existing user-owned records are not migrated here.
model Organization {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  displayName String?
  logoUrl     String?
  accentColor String?
  status      String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  domains     OrganizationDomain[]
  financeLink OrganizationFinanceLink?
  bankAccounts BankAccount[]
  bankStatements BankStatement[]
  bankTransactions BankTransaction[]
  whatsappMessages WhatsAppMessage[]

  @@index([status])
}

model OrganizationMembership {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  role           String @default("MEMBER")
  financeAccess  Boolean @default(false)
  status         String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model OrganizationDomain {
  id             String @id @default(cuid())
  organizationId String
  hostname       String @unique
  verifiedAt     DateTime?
  isPrimary      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([verifiedAt])
}


/// Owner-controlled binding to the existing KSeF pilot. Credentials remain
/// with the original owner. No private financial document is migrated or shared.
model OrganizationFinanceLink {
  id             String @id @default(cuid())
  organizationId String @unique
  ownerUserId    String
  nip            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, nip])
  @@index([ownerUserId])
  @@index([nip])
}


/// Bank data is tenant-scoped and never shared across organizations.
model BankAccount {
  id String @id @default(cuid())
  organizationId String
  iban String
  label String?
  accountType String @default("CURRENT")
  currency String @default("PLN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statements BankStatement[]
  transactions BankTransaction[]

  @@unique([organizationId, iban])
  @@index([organizationId])
}

model BankStatement {
  id String @id @default(cuid())
  organizationId String
  bankAccountId String
  statementNumber String
  sourceHash String
  openingBalance Decimal @db.Decimal(18, 2)
  closingBalance Decimal @db.Decimal(18, 2)
  periodStart DateTime?
  periodEnd DateTime
  importedAt DateTime @default(now())
  importedByUserId String
  transactionCount Int @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([organizationId, sourceHash, bankAccountId, statementNumber])
  @@index([organizationId, bankAccountId, periodEnd])
}

model BankTransaction {
  id String @id @default(cuid())
  organizationId String
  bankAccountId String
  bankStatementId String
  fingerprint String
  bookedAt DateTime
  amount Decimal @db.Decimal(18, 2)
  balanceAfter Decimal? @db.Decimal(18, 2)
  description String @default("")
  counterparty String?
  reference String?
  externalId String?
  reviewStatus String @default("UNMATCHED")
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankStatement BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  @@unique([organizationId, bankStatementId, fingerprint])
  @@index([organizationId, bookedAt])
  @@index([organizationId, bankAccountId, bookedAt])
}

model WhatsAppMessage {
  id String @id @default(cuid())
  organizationId String
  externalMessageId String @unique
  phoneNumberId String
  contactWaId String
  direction String @default("INBOUND")
  messageType String
  text String?
  receivedAt DateTime @default(now())
  metadata Json?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, receivedAt])
  @@index([organizationId, contactWaId, receivedAt])
}
